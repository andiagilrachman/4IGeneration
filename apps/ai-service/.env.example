# apps/ai-service — salin ke .env
APP_ENV=development
AI_SERVICE_NAME=4ig-ai-service

# --- AI Provider Keys (daftar di BAGIAN 11 blueprint) ---
# GEMINI: pakai model alias gemini-flash-latest (model 1.5/2.x tidak tersedia utk akun baru)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Konfigurasi gateway (default) ---
GATEWAY_TIMEOUT_MS=30000
GATEWAY_MAX_RETRIES=3

# --- Cache (Week 10 — Redis) ---
REDIS_URL=redis://localhost:6379
STOCK_CACHE_TTL_SECONDS=43200

# --- Model lokal (Phase 4 — Own Model, W37-38) ---
# Isi bila sudah punya GPU + Ollama/vLLM. Model jadi provider fallback terakhir.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:8b
