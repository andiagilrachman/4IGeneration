// ============================================================
// 4IGeneration — Prisma Schema (MySQL 8.0)
// Referensi: docs/blueprint BAGIAN 7 (Database Schema, 30+ tabel)
// Prinsip: UUID public ID · soft delete · timestamps · JSON columns
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// 1. AUTHENTICATION & USERS
// ------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String   @id @default(uuid()) @db.Char(36)
  email           String   @unique @db.VarChar(255)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  name            String?  @db.VarChar(120)
  role            UserRole @default(USER)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at") // soft delete

  profile         UserProfile?
  sessions        Session[]
  apiKeys         ApiKey[]
  subscriptions   Subscription[]
  credits         Credit?
  watchlists      Watchlist[]
  analysis        AnalysisRequest[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([status])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id")
  fullName  String?  @map("full_name") @db.VarChar(160)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  phone     String?  @db.VarChar(30)
  country   String?  @default("ID") @db.Char(2)
  preferences Json? // JSON: preferensi UI, notifikasi, dsb
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Session {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String   @db.VarChar(255)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String   @db.VarChar(255)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("email_verifications")
}

// ------------------------------------------------------------
// 2. SUBSCRIPTION & BILLING
// ------------------------------------------------------------

enum PlanType {
  FREE
  RETAIL
  API
  ENTERPRISE
}

enum PlanBillingPeriod {
  MONTHLY
  YEARLY
  LIFETIME
}

model Plan {
  id          String    @id @default(uuid()) @db.Char(36)
  slug        String    @unique @db.VarChar(80)
  name        String    @db.VarChar(120)
  description String?   @db.Text
  type        PlanType  @default(RETAIL)
  priceMonthly Decimal  @default(0) @db.Decimal(12, 2)
  priceYearly  Decimal? @default(0) @db.Decimal(12, 2)
  currency    String    @default("IDR") @db.Char(3)
  creditsPerMonth Int   @default(0) @map("credits_per_month")
  features    Json? // JSON: daftar fitur
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIALING
}

model Subscription {
  id          String               @id @default(uuid()) @db.Char(36)
  userId      String               @map("user_id")
  planId      String               @map("plan_id")
  status      SubscriptionStatus   @default(TRIALING)
  startsAt    DateTime             @map("starts_at")
  endsAt      DateTime?            @map("ends_at")
  cancelledAt DateTime?            @map("cancelled_at")
  trialEndsAt DateTime?            @map("trial_ends_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan                 @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Credit {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id")
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credits")
}

enum CreditTransactionType {
  PURCHASE
  SUBSCRIPTION_ALLOCATION
  USAGE_DEDUCTION
  REFUND
  ADJUSTMENT
}

model CreditTransaction {
  id          String               @id @default(uuid()) @db.Char(36)
  creditId    String               @map("credit_id")
  type        CreditTransactionType
  amount      Int                  // + / -
  description String?              @db.VarChar(255)
  referenceId String?              @map("reference_id") @db.VarChar(80)
  createdAt   DateTime             @default(now()) @map("created_at")

  credit      Credit               @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId, createdAt])
  @@map("credit_transactions")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid()) @db.Char(36)
  userId        String        @map("user_id")
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("IDR") @db.Char(3)
  status        PaymentStatus @default(PENDING)
  gateway       String        @default("midtrans") @db.VarChar(30)
  gatewayRef    String?       @map("gateway_ref") @db.VarChar(120)
  metadata      Json?
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  invoice       Invoice?

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id        String    @id @default(uuid()) @db.Char(36)
  paymentId String    @unique @map("payment_id")
  number    String    @unique @db.VarChar(40)
  amount    Decimal   @db.Decimal(12, 2)
  currency  String    @default("IDR") @db.Char(3)
  status    String    @default("UNPAID") @db.VarChar(20)
  dueDate   DateTime? @map("due_date")
  createdAt DateTime  @default(now()) @map("created_at")

  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

// ------------------------------------------------------------
// 3. API KEYS & ACCESS
// ------------------------------------------------------------

model ApiKey {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id")
  name      String    @db.VarChar(120)
  keyPrefix String    @map("key_prefix") @db.VarChar(12) // 8 chars pertama
  keyHash   String    @unique @map("key_hash") @db.VarChar(255) // bcrypt
  scopes    Json? // JSON: [ "analysis:read", ... ]
  isActive  Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs ApiKeyUsageLog[]

  @@index([userId])
  @@map("api_keys")
}

model ApiKeyUsageLog {
  id          String   @id @default(uuid()) @db.Char(36)
  apiKeyId    String   @map("api_key_id")
  endpoint    String   @db.VarChar(160)
  statusCode  Int?     @map("status_code")
  tokensUsed  Int?     @map("tokens_used")
  createdAt   DateTime @default(now()) @map("created_at")

  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
  @@map("api_key_usage_logs")
}

// ------------------------------------------------------------
// 4. AI PROVIDERS (no hardcode — dikelola via admin panel)
// ------------------------------------------------------------

model AiProvider {
  id          String   @id @default(uuid()) @db.Char(36)
  slug        String   @unique @db.VarChar(60) // gemini, groq, mistral, openrouter
  name        String   @db.VarChar(120)
  baseUrl     String   @map("base_url") @db.VarChar(255)
  authType    String   @default("api_key_header") @map("auth_type") @db.VarChar(40)
  priority    Int      @default(100)
  weight      Int      @default(0)
  timeoutMs   Int      @default(30000) @map("timeout_ms")
  maxRetries  Int      @default(3) @map("max_retries")
  healthPath  String?  @map("health_path") @db.VarChar(160)
  config      Json? // JSON: konfigurasi tambahan
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  keys        ProviderKey[]
  models      AiModel[]

  @@map("ai_providers")
}

enum ProviderKeyStatus {
  ACTIVE
  COOLING_DOWN
  RATE_LIMITED
  DISABLED
  DEAD
}

model ProviderKey {
  id             String            @id @default(uuid()) @db.Char(36)
  providerId     String            @map("provider_id")
  label          String?           @db.VarChar(80)
  encryptedKey   String            @map("encrypted_key") @db.Text // AES-256 encrypted
  status         ProviderKeyStatus @default(ACTIVE)
  dailyUsed      Int               @default(0) @map("daily_used")
  dailyLimit     Int               @default(1500) @map("daily_limit")
  monthlyUsed    Int               @default(0) @map("monthly_used")
  monthlyLimit   Int               @default(45000) @map("monthly_limit")
  coolingUntil   DateTime?         @map("cooling_until")
  lastUsedAt     DateTime?         @map("last_used_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  provider       AiProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
  @@map("provider_keys")
}

model AiModel {
  id          String    @id @default(uuid()) @db.Char(36)
  providerId  String    @map("provider_id")
  modelId     String    @map("model_id") @db.VarChar(120) // gemini-1.5-flash, dst
  alias       String    @db.VarChar(40) // 4IG-Small, 4IG-Pro, ...
  contextWindow Int     @default(128000) @map("context_window")
  priceInput  Decimal   @default(0) @map("price_input") @db.Decimal(12, 6) // per 1K token
  priceOutput Decimal   @default(0) @map("price_output") @db.Decimal(12, 6)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  provider    AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("ai_models")
}

// ------------------------------------------------------------
// 5. STOCK DATA
// ------------------------------------------------------------

model Stock {
  id        String   @id @default(uuid()) @db.Char(36)
  ticker    String   @unique @db.VarChar(10)
  name      String   @db.VarChar(160)
  sector    String?  @db.VarChar(80)
  industry  String?  @db.VarChar(80)
  isIdx     Boolean  @default(false) @map("is_idx") // index seperti LQ45/IDX30
  idxName   String?  @map("idx_name") @db.VarChar(40)
  listedAt  DateTime? @map("listed_at")
  metadata  Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prices       StockPrice[]
  fundamentals StockFundamental[]
  news         StockNews[]

  @@index([sector])
  @@map("stocks")
}

model StockPrice {
  id        String   @id @default(uuid()) @db.Char(36)
  stockId   String   @map("stock_id")
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(12, 2)
  high      Decimal  @db.Decimal(12, 2)
  low       Decimal  @db.Decimal(12, 2)
  close     Decimal  @db.Decimal(12, 2)
  volume    BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, date])
  @@index([stockId, date])
  @@map("stock_prices")
}

model StockFundamental {
  id        String   @id @default(uuid()) @db.Char(36)
  stockId   String   @map("stock_id")
  period    String   @db.VarChar(10) // 2024-Q4, 2024-A, dst
  revenue   Decimal? @db.Decimal(18, 2)
  netIncome Decimal? @map("net_income") @db.Decimal(18, 2)
  eps       Decimal? @db.Decimal(12, 2)
  pe        Decimal? @db.Decimal(12, 2)
  pbv       Decimal? @db.Decimal(12, 2)
  roe       Decimal? @db.Decimal(6, 2)
  debtToEquity Decimal? @map("debt_to_equity") @db.Decimal(6, 2)
  data      Json? // JSON: data lengkap dari sumber
  createdAt DateTime @default(now()) @map("created_at")

  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, period])
  @@map("stock_fundamentals")
}

model StockNews {
  id          String   @id @default(uuid()) @db.Char(36)
  stockId     String   @map("stock_id")
  title       String   @db.VarChar(300)
  url         String?  @db.VarChar(500)
  source      String?  @db.VarChar(120)
  publishedAt DateTime @map("published_at")
  sentiment   String?  @db.VarChar(20) // positive/negative/neutral
  content     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, publishedAt])
  @@map("stock_news")
}

// ------------------------------------------------------------
// 6. ANALYSIS & USAGE
// ------------------------------------------------------------

enum AnalysisType {
  STOCK
  COMPARE
  SCREENER
  SENTIMENT
  SUMMARY
  CHAT
  MARKET_RECAP
  PORTFOLIO
}

model AnalysisRequest {
  id           String       @id @default(uuid()) @db.Char(36)
  userId       String       @map("user_id")
  type         AnalysisType
  input        Json? // JSON: input pengguna (ticker, query, dst)
  promptUsed   String?      @map("prompt_used") @db.Text
  result       Json? // JSON: hasil analisis ternormalisasi
  provider     String?      @db.VarChar(40)
  modelAlias   String?      @map("model_alias") @db.VarChar(40)
  tokensUsed   Int?         @map("tokens_used")
  creditsCost  Int?         @map("credits_cost")
  status       String       @default("COMPLETED") @db.VarChar(20)
  errorMessage String?      @map("error_message") @db.VarChar(500)
  responseTimeMs Int?       @map("response_time_ms")
  createdAt    DateTime     @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("analysis_requests")
}

model UsageLog {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @map("user_id")
  endpoint    String   @db.VarChar(160)
  method      String?  @db.VarChar(10)
  statusCode  Int?     @map("status_code")
  tokensUsed  Int?     @map("tokens_used")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([endpoint, createdAt])
  @@map("usage_logs")
}

model RateLimitHit {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @map("user_id")
  apiKeyId  String?  @map("api_key_id")
  endpoint  String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("rate_limit_hits")
}

model Watchlist {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id")
  name      String   @default("My Watchlist") @db.VarChar(120)
  tickers   Json? // JSON: array ticker
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("watchlists")
}

// ------------------------------------------------------------
// 7. SYSTEM CONFIGURATION (no hardcode!)
// ------------------------------------------------------------

model Setting {
  id        String   @id @default(uuid()) @db.Char(36)
  category  String   @db.VarChar(40) // general, email, payments, security, ...
  key       String   @db.VarChar(80)
  value     Json?
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, key])
  @@map("settings")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Char(36)
  slug      String   @unique @db.VarChar(80)
  description String? @db.VarChar(255)
  isEnabled Boolean  @default(false) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model PromptTemplate {
  id          String   @id @default(uuid()) @db.Char(36)
  slug        String   @unique @db.VarChar(80) // screener, analysis, sentiment, recap, ...
  name        String   @db.VarChar(120)
  content     String   @db.Text
  version     Int      @default(1)
  variables   Json? // JSON: daftar variabel yang tersedia
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("prompt_templates")
}

model ContentPage {
  id        String   @id @default(uuid()) @db.Char(36)
  slug      String   @unique @db.VarChar(120)
  title     String   @db.VarChar(200)
  body      String   @db.LongText
  seoTitle  String?  @map("seo_title") @db.VarChar(200)
  seoDescription String? @map("seo_description") @db.VarChar(300)
  isPublished Boolean @default(false) @map("is_published")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_pages")
}

model EmailTemplate {
  id        String   @id @default(uuid()) @db.Char(36)
  slug      String   @unique @db.VarChar(80) // welcome, verify_email, reset_password, ...
  subject   String   @db.VarChar(200)
  body      String   @db.LongText
  variables Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

// ------------------------------------------------------------
// 8. AUDIT & NOTIFICATIONS
// ------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @map("user_id")
  action    String   @db.VarChar(80) // user.suspend, plan.update, ...
  entityType String? @map("entity_type") @db.VarChar(60)
  entityId  String?  @map("entity_id") @db.Char(36)
  metadata  Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id")
  type      String    @db.VarChar(40) // system, billing, analysis, api, ...
  title     String    @db.VarChar(200)
  body      String?   @db.Text
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model EmailLog {
  id        String   @id @default(uuid()) @db.Char(36)
  to        String   @db.VarChar(255)
  template  String?  @db.VarChar(80)
  subject   String?  @db.VarChar(200)
  status    String   @default("SENT") @db.VarChar(20)
  error     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([to, createdAt])
  @@map("email_logs")
}
