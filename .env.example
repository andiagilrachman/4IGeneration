# ============================================================
# 4IGeneration — Contoh Environment Variables (Root / Shared)
# Salin ke .env lalu isi sesuai kebutuhan. JANGAN commit .env!
# ============================================================

# --- Umum ---
NODE_ENV=development
APP_NAME=4IGeneration
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
AI_SERVICE_URL=http://localhost:8000
TIMEZONE=Asia/Makassar
TZ=Asia/Makassar

# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=4igeneration
MYSQL_USER=4ig
MYSQL_PASSWORD=4ig_pass
MYSQL_PORT=3306

# --- Redis ---
REDIS_PASSWORD=4ig_redis
REDIS_PORT=6379

# --- Secret (GANTI dengan nilai kuat saat production) ---
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY=change-me-32byte-key

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@4igeneration.com

# --- Payment (fase 2) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Monitoring ---
SENTRY_DSN=
